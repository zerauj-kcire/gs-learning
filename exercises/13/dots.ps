
<< /PageSize [ 74 74 ] >> setpagedevice

/dot {
	/a exch def
	/b exch def
	newpath
	b a moveto
	0 0 rlineto
	stroke
} def

% square
newpath 
0 0 moveto 
72 0 rlineto
0 72 rlineto 
-72 0 rlineto
closepath
stroke

1 setlinecap
10 20 dot

2 setlinewidth
20 30 dot

4 setlinewidth
30 40 dot

8 setlinewidth
40 50 dot
50 60 dot
